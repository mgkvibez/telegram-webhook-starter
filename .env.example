# 1. Get this from @BotFather in Telegram (30 seconds, see README).
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# 2. Any random string. Telegram echoes it back on every webhook call and the app
#    refuses updates that do not match, so nobody can post fake updates to your bot.
#    Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=replace-me-with-a-long-random-string

# 3. Protects /admin/set-webhook. Without it those routes are disabled entirely,
#    because a public endpoint that sets your webhook can hijack your bot.
ADMIN_TOKEN=replace-me-too

# Optional integrations. The bot works without them; those commands just say
# they are not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GITHUB_TOKEN=

# Optional tuning.
TELEGRAM_API_BASE=https://api.telegram.org
DEDUPE_TTL_SECONDS=900
REQUEST_TIMEOUT=10
